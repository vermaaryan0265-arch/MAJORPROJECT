<%= layout("/layouts/boilerplate") %> 
<body>
    <!-- <h3>All Listings</h3> -->
    <!-- <form method="GET" action="/listings/new">
        <button>
            Create New Listing
        </button>
    </form> -->
    <style>
          #filters{
            display: flex;
            flex-wrap: wrap;
        }
        .filter{
            margin-top: 2rem;
            text-align: center;
            margin-right: 2rem;
            opacity: 0.7;
        }
        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }
        .filter p {
            font-size: 0.8rem;
        }
      
    </style>
    <div id="filters">
         <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p> Trending</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p> Rooms</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-tree-city"></i></div>
            <p> Iconic cities</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-umbrella"></i></div>
            <p> Beachs</p>
         </div>
         <div class="filter">
            <div><i class="fa-regular fa-house"></i></div>
            <p> cabin</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p> Castels</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-water-ladder"></i></i></div>
            <p> pools</p>
         </div>
         <div class="filter">
            <div><i class="fa-solid fa-dungeon"></i></div>
            <p> Camping</p>
         </div>

    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <%  for(let listing of allListings){  %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col " >
                <img
                 src="<%= listing.image.url || 
                 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60'
                 %>" 
                 class="card-img-top" 
                 alt="listing_image" 
                 style="height: 20rem">

                 <div class="card-img-overlay"></div>
                <div class="card-body">
                  <p class="card-text">
                  <b> <%= listing.title %></b>  <br>
                    &#8377;<%= listing.price.toLocaleString("en-IN")%>/night
                <br></p>
                </div>
              </div>
              </a>
              <%   } %>
    </div>
   

    <!-- <ul>
      <%  for(let listing of allListings){  %>
            <li> <a href="/listings/<%= listing._id %>"><%= listing.title %></a></li>
            <%   } %>
    </ul> -->
</body>


